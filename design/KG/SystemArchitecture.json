{
"id": "1748",
"name": "ai4x_query"
,"parent": "1739"
,"type": "ArchiMate_ApplicationComponent,_TOOL_"
,"description": "description: \"Discover, progressively inspect schema, and query AI4X Platform through the platform-owned MCP boundary.\",\r\nargs: {\r\n  command: tool.schema.enum([\"catalog\", \"schema\", \"detail\", \"query\"]),\r\n  sourceId/source_id: tool.schema.string().optional(),\r\n  detailKind/detail_kind: tool.schema.string().optional(),\r\n  typeName/type_name: tool.schema.string().optional(),\r\n  cypher/query: tool.schema.string().optional(),\r\n  paramsJson: tool.schema.string().optional(),\r\n  limit: tool.schema.number().int().optional(),\r\n  requestId/request_id: tool.schema.string().optional(),\r\n  openctiExecutionPreference: tool.schema.string().optional()\r\n}"
,"attributes": [
{
"name": "canonical_boundary"
,"description": "OPENCODE 通过已注册的远端 AI4X HTTP MCP server 直接发现并调用该 tool，不再把工作区本地 JS/CLI 包装作为正式路径。"
},
{
"name": "caller_visible_surface"
,"description": "tool 名称保持 ai4x_query；命令面保持 catalog、schema、detail、query，并兼容 sourceId/source_id、detailKind/detail_kind、typeName/type_name、cypher/query、requestId/request_id 等参数别名。"
},
{
"name": "access_policy"
,"description": "AI4X MCP 注册完成后，该 tool 对所有 agent 可见；权限治理由 MCP 注册与运行时策略负责，而不是由本地兼容壳限制为 ThreatIntelAnalyst。"
}
]
