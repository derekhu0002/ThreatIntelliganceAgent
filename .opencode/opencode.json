{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/introduce-before-talk.ts"
  ],
  "instructions": [
    "agent_app/opencode_app/.opencode/GLOBAL_INSTRUCTIONS.md"
  ],
  "mcp": {
    "ai4x": {
      "type": "remote",
      "url": "http://localhost:8000/mcp"
    }
  },
  "permission": {
    "mcp_*": "ask",
    "skill": {
      "*": "allow"
    }
  }
}
