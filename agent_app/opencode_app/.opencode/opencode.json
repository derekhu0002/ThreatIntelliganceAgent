{
  "$schema": "https://opencode.ai/config.json",
  "model": "DeepSeek_custom_provider/deepseek-chat",
  "default_agent": "安全运营助手",
  "mcp": {
    "ai4x": {
      "type": "remote",
      "url": "http://localhost:8000/mcp"
    }
  },
  "provider": {
    "DeepSeek_custom_provider": {
      "models": {
        "deepseek-chat": {
          "name": "deepseek-chat",
          "limit": {
            "context": 128000,
            "output": 4096
          }
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek custom provider",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "xxx"
      }
    }
  },
  "instructions": [
    ".opencode/GLOBAL_INSTRUCTIONS.md"
  ],
  "permission": {
    "mcp_*": "ask",
    "skill": {
      "*": "allow"
    }
  }
}
